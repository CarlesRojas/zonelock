{
  "multipart": [
    {
      "when": {
        "OR": [
          {
            "armed": "true",
            "powered": "true"
          },
          {
            "pending": "true",
            "powered": "true"
          }
        ]
      },
      "apply": {
        "model": "zonelock:block/redstone_core_armed_powered"
      }
    },
    {
      "when": {
        "OR": [
          {
            "armed": "true",
            "powered": "false"
          },
          {
            "pending": "true",
            "powered": "false"
          }
        ]
      },
      "apply": {
        "model": "zonelock:block/redstone_core_armed"
      }
    },
    {
      "when": {
        "armed": "false",
        "pending": "false",
        "powered": "true"
      },
      "apply": {
        "model": "zonelock:block/redstone_core_unarmed_powered"
      }
    },
    {
      "when": {
        "armed": "false",
        "pending": "false",
        "powered": "false"
      },
      "apply": {
        "model": "zonelock:block/redstone_core_unarmed"
      }
    }
  ]
}
