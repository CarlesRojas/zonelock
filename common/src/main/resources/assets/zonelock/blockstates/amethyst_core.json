{
  "multipart": [
    {
      "when": {
        "OR": [
          {
            "armed": "true"
          },
          {
            "pending": "true"
          }
        ]
      },
      "apply": {
        "model": "zonelock:block/amethyst_core_armed"
      }
    },
    {
      "when": {
        "armed": "false",
        "pending": "false"
      },
      "apply": {
        "model": "zonelock:block/amethyst_core_unarmed"
      }
    }
  ]
}
